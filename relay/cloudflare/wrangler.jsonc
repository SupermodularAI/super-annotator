{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "annotate-live",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/sync", "/health"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "AnnotateRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AnnotateRoom"] }],
  "vars": {
    // Name-only identities by default. Set COLLECT_EMAIL to "on" (and the
    // page's SM_ANNOTATE_SYNC.collectEmail to true) to ask for an email, and
    // NEWSLETTER_SIGNUPS to "on" to forward opt-ins to SIGNUP_URL.
    "COLLECT_EMAIL": "off",
    "NEWSLETTER_SIGNUPS": "off",
    "SIGNUP_URL": "",
    "ALLOWED_ORIGINS": ""
  }
  // Secrets (wrangler secret put): ADMIN_TOKEN (moderation), SIGNUP_INGEST_TOKEN (only used with NEWSLETTER_SIGNUPS=on)
}
